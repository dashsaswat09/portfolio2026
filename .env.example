# Copy to .env.local for local development. Set the same values in Vercel → Settings → Environment Variables.
# Never commit real keys.

# Gemini API key from https://aistudio.google.com/apikey (free tier).
# Without it the site works; typed questions get the fallback answer.
GEMINI_API_KEY=

# Model ID. Check the current free-tier list at https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.5-flash-lite

# Limits (per server instance; the provider's quota is the real ceiling)
AI_LIMIT_PER_MINUTE=6
AI_LIMIT_PER_VISITOR_DAY=30
AI_LIMIT_GLOBAL_DAY=300
AI_TIMEOUT_MS=9000
AI_MAX_OUTPUT_TOKENS=400
